{
  "name": "Chat with PDFs",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements.txt && python sample_docs/download_samples.py",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit app", "onAutoForward": "openPreview" }
  },
  "secrets": {
    "OPENAI_API_KEY": { "description": "OpenAI API key used for embeddings and the chat model." }
  }
}
