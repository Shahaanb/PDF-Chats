# Copy to .env for local runs. In GitHub Codespaces these come from the repository's Codespaces secrets.
# At least one key is needed. Gemini is used by default when both are set.
GOOGLE_API_KEY="your_google_api_key"
OPENAI_API_KEY="your_openai_api_key"

# Optional overrides
# LLM_PROVIDER="openai"
# EMBEDDINGS="provider"   # use the provider's embedding API instead of the local model
# LOCAL_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
# GOOGLE_CHAT_MODEL="gemini-3.5-flash-lite"
# GOOGLE_EMBEDDING_MODEL="models/gemini-embedding-001"
# OPENAI_CHAT_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
